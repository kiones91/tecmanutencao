# .env.example — TecManutenções ERP

# ============================================
# SUPABASE
# ============================================
# Obter em: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# ============================================
# EDGE FUNCTIONS SECRETS (configurar no Supabase Dashboard)
# ============================================
# Ir para: Project Settings → Edge Functions → Secrets
# NÃO colocar estas chaves no .env.local (usar supabase secrets set)

# OPENAI_API_KEY=sk-...              # Chave da OpenAI para Whisper/Vision
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Service Role Key (NUNCA expor no frontend)

# ============================================
# CLOUDFLARE TURNSTILE (opcional, produção)
# ============================================
# Obter em: https://www.cloudflare.com/application-services/products/turnstile/

NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ============================================
# FOCUS NFE (Fase 5 - Fiscal)
# ============================================
# Obter em: https://focusnfe.com.br

FOCUSNFE_TOKEN=SEU_TOKEN_AQUI
FOCUSNFE_AMBIENTE=homologacao  # ou 'producao'

# ============================================
# GERAL
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
